# Copy to .env (or export these) -- all optional
FLASK_DEBUG=0                 # never enable on a network-reachable machine
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
RATE_LIMIT_PER_MIN=20         # per IP, 0 disables
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT=60           # seconds; leave unset to use the client default
LOG_LEVEL=INFO

# To avoid prompt truncation on small models, create a model with a 4096-token context:
#   ollama create glowithm -f ollama/Modelfile      then:  OLLAMA_MODEL=glowithm
