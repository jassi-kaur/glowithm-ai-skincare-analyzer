# Gives the local model a larger context window than Ollama's default, so the
# prompt (rules + ingredient reference) is never silently truncated.
#   ollama create glowithm -f ollama/Modelfile
#   set OLLAMA_MODEL=glowithm     (see .env.example)
FROM llama3.2:3b
PARAMETER num_ctx 4096
PARAMETER temperature 0.3
